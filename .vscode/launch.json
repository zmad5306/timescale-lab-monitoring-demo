{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Full Stack Demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "f5: bootstrap, web, build api",
      "program": "${workspaceFolder}/src/LabMonitor.Api/bin/Debug/net10.0/LabMonitor.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/LabMonitor.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+http://localhost:5053",
        "uriFormat": "http://127.0.0.1:5173/"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5053"
      }
    }
  ]
}
