{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack Demo",
      "configurations": [
        "Web Dev Server",
        "LabMonitor API"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Web Dev Server",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "preLaunchTask": "web: install",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--strictPort",
        "--clearScreen",
        "false"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "LabMonitor API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "f5: api ready",
      "program": "${workspaceFolder}/src/LabMonitor.Api/bin/Debug/net10.0/LabMonitor.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/LabMonitor.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+http://localhost:5053",
        "uriFormat": "http://127.0.0.1:5173/"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5053"
      }
    }
  ]
}
