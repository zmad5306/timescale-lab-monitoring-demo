{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bootstrap: db + seed if needed",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/bootstrap-dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/bootstrap-dev.ps1"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "web: install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "problemMatcher": []
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --strictPort --clearScreen false",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "FORCE_COLOR": "0",
          "NO_COLOR": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://(127\\.0\\.0\\.1|localhost):5173/.*"
        }
      }
    },
    {
      "label": "build: api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/LabMonitor.Api/LabMonitor.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "f5: api ready",
      "dependsOrder": "sequence",
      "dependsOn": [
        "bootstrap: db + seed if needed",
        "build: api"
      ],
      "problemMatcher": []
    }
  ]
}
